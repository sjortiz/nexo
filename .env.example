# Local models on Apple Silicon (Ollama): set a hardware profile instead of the
# model settings below; see deploy/local/local.env.example.
# LOCAL_PROFILE=m1-max-64
# REMOTE_PROFILE=m1-max-64     # with LOCAL_PROFILE=m5-pro-24: a second Mac serves agent + extraction

# vLLM (OpenAI-compatible)
VLLM_BASE_URL=http://vllm-inference-service:8000/v1
VLLM_API_KEY=change-me
VLLM_MODEL=meta-llama/Llama-3.3-70B-Instruct
HF_TOKEN=

# Embeddings (separate pooling server); EMBEDDING_PROVIDER=fake for offline dev
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_BASE_URL=http://vllm-embedding-service:8000/v1
EMBEDDING_API_KEY=change-me
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSIONS=1024

# Neo4j (writer for ingestion; reader-role account for the agent tool)
NEO4J_URI=neo4j://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_READ_USER=
NEO4J_READ_PASSWORD=

# Sensitive data: none | regex | comprehend_medical (sends text to AWS; needs AWS_REGION + approval)
SENSITIVE_DATA_PROVIDER=regex
SENSITIVE_DATA_POLICY=tag
AWS_REGION=
DEFAULT_CLEARANCE=internal
# Relation ontology (synonyms, inverses, type constraints); unset = free-form predicates
# ONTOLOGY_PATH=deploy/ontology.example.json
# Entity resolution: off | deterministic | llm
ENTITY_RESOLUTION=llm
# GLOSSARY_PATH=glossary.json

# Human-review checkpoints must outlive the process: sqlite (single node) or postgres
CHECKPOINT_BACKEND=sqlite
# CHECKPOINT_POSTGRES_URI=postgresql://user:pass@host:5432/nexo
# (which answers wait for a person: spec.review in nexo.yaml, rendered as REVIEW_POLICY)

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# Message content in telemetry: no_content | span_only | event_only | span_and_event
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=no_content
DEPLOYMENT_ENVIRONMENT=dev
# Traces, metrics and logs go through the collector to SigNoz; Langfuse, Jaeger and
# LangSmith are add-ons (make up LANGFUSE=1 / JAEGER=1 / LANGSMITH=1). Leave LANGSMITH_TRACING unset: the collector
# exports, so app-side tracing would duplicate traces. Locally `make env` keeps the secrets
# below in ~/.config/nexo/config and these stay empty; a cluster mounts them as files
# (secrets.provider file with a path), never as environment variables.

# SigNoz (self-hosted by `make up`, UI on http://localhost:8080): `make env` fills
# these with random values. Log in as SIGNOZ_USER_EMAIL / SIGNOZ_USER_PASSWORD.
SIGNOZ_USER_EMAIL=admin@nexo.local
SIGNOZ_USER_PASSWORD=
SIGNOZ_JWT_SECRET=
SIGNOZ_POSTGRES_PASSWORD=

# Langfuse add-on for LLM evaluation (make up LANGFUSE=1, UI on http://localhost:3000):
# `make env` fills these too. Log in as LANGFUSE_USER_EMAIL / LANGFUSE_USER_PASSWORD.
# With LANGFUSE_HOST set (nexo setup sets it), nexo eval also runs as a Langfuse experiment.
# LANGFUSE_HOST=http://localhost:3000
LANGFUSE_USER_EMAIL=admin@nexo.local
LANGFUSE_USER_PASSWORD=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_POSTGRES_PASSWORD=
LANGFUSE_CLICKHOUSE_PASSWORD=
LANGFUSE_REDIS_PASSWORD=
LANGFUSE_S3_SECRET=

# Add-on: LangSmith
# LANGSMITH_API_KEY=
# (the project: addons.langsmith.project in nexo.yaml)

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=text

# LLM-as-a-judge for `nexo eval` (prefer a different model than the generator)
# JUDGE_BASE_URL=
# JUDGE_MODEL=
