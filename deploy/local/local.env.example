# Nexo with local models (Ollama on Apple Silicon or Linux). Copy to .env on the machine that runs Nexo.
# Profiles: <chip>-<memory GB> on a Mac (m1-pro-16, m5-pro-24, m1-max-64), gpu-<VRAM GB> or
# cpu-<RAM GB> on Linux. How it works: docs/operations/local-setup.md. Check: nexo models --check

# Option 1 - one Mac serves every model:
LOCAL_PROFILE=m1-max-64

# Option 2 - two Macs: this Mac serves router, embeddings and judge (and runs Nexo,
# Neo4j, telemetry); the remote Mac serves the agent and extraction models through
# an SSH tunnel:  ssh -N -L 11435:127.0.0.1:11434 you@m1-max.local
# LOCAL_PROFILE=m5-pro-24
# REMOTE_PROFILE=m1-max-64
# REMOTE_BASE_URL=http://localhost:11435/v1

# Explicit settings win over the profile, e.g. a different agent model:
# AGENT_MODEL=qwen3:30b-a3b-instruct-2507-q4_K_M

# Native path: Neo4j from Homebrew; Podman path: the compose service (same port)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Telemetry: the compose collector, which sends traces, metrics and logs to SigNoz (and
# traces to Langfuse, Jaeger or LangSmith when enabled). Without containers, leave it empty.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=no_content
# otlp: also send logs (to SigNoz)
OTEL_LOGS_EXPORTER=none
DEPLOYMENT_ENVIRONMENT=local

# SigNoz (self-hosted by `make up`, UI on http://localhost:8080): `make env` fills
# these with random values. Log in as SIGNOZ_USER_EMAIL / SIGNOZ_USER_PASSWORD.
SIGNOZ_USER_EMAIL=admin@nexo.local
SIGNOZ_USER_PASSWORD=
SIGNOZ_JWT_SECRET=
SIGNOZ_POSTGRES_PASSWORD=

# Langfuse add-on for LLM evaluation (make up LANGFUSE=1, UI on http://localhost:3000):
# `make env` fills these too. Log in as LANGFUSE_USER_EMAIL / LANGFUSE_USER_PASSWORD.
LANGFUSE_USER_EMAIL=admin@nexo.local
LANGFUSE_USER_PASSWORD=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_POSTGRES_PASSWORD=
LANGFUSE_CLICKHOUSE_PASSWORD=
LANGFUSE_REDIS_PASSWORD=
LANGFUSE_S3_SECRET=

# Add-on: also send traces to LangSmith (make up LANGSMITH=1)
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=nexo
