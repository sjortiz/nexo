# Secrets and personal settings for Nexo with local models. `make env` creates .env from this
# file and fills the empty secrets; nexo.yaml describes the setup (profiles, add-ons), and what
# it renders (.nexo/render/nexo.env) is read after this file. How it works:
# docs/operations/local-setup.md. Check: make check

# Explicit settings win over the profile in nexo.yaml, e.g. a different agent model:
# AGENT_MODEL=qwen3:30b-a3b-instruct-2507-q4_K_M

# Without nexo setup (Neo4j from Homebrew, no containers), set the rest here:
# LOCAL_PROFILE=m1-max-64
# REMOTE_PROFILE=m1-max-64     # two machines: with LOCAL_PROFILE=m5-pro-24 and an SSH tunnel
# NEO4J_URI=bolt://localhost:7687
# OTEL_EXPORTER_OTLP_ENDPOINT=  # empty: no telemetry export

# Generated secrets (Neo4j, SigNoz, Langfuse passwords and keys) are not kept here:
# `make env` creates them in your OS keychain, or ~/.config/nexo/config where there is
# none (secrets.provider in nexo.yaml: keychain, env, sops, vault).
NEO4J_USER=neo4j

# Message content in telemetry: no_content | span_only | event_only | span_and_event
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=no_content
DEPLOYMENT_ENVIRONMENT=local

# SigNoz UI on http://localhost:8080: log in as SIGNOZ_USER_EMAIL with the password in your
# keychain (service nexo/nexo, SIGNOZ_USER_PASSWORD).
SIGNOZ_USER_EMAIL=admin@nexo.local

# Langfuse add-on (make up LANGFUSE=1, UI on http://localhost:3000): log in as
# LANGFUSE_USER_EMAIL with LANGFUSE_USER_PASSWORD from the keychain.
LANGFUSE_USER_EMAIL=admin@nexo.local

# Add-on: also send traces to LangSmith (make up LANGSMITH=1)
# LANGSMITH_API_KEY=
# (the project: addons.langsmith.project in nexo.yaml)
