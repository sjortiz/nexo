# Nexo on two Macs (copy to .env on the Mac that runs Nexo, Neo4j and the collector).
#
#   M1 Max  : Ollama with the agent + extraction model  (deploy/local/ollama-setup.sh m1-max-32|m1-max-64)
#   M5 Pro  : Ollama with router, embeddings, judge     (deploy/local/ollama-setup.sh m5-pro-24)
#             + Neo4j/collector/Jaeger (podman) + Nexo
#
# The M1 Max's Ollama stays on 127.0.0.1; reach it through an SSH tunnel from the M5 Pro:
#   ssh -N -L 11435:127.0.0.1:11434 you@m1-max.local

# Default endpoint (router, judge and anything not overridden): local Ollama
VLLM_BASE_URL=http://localhost:11434/v1
VLLM_API_KEY=ollama
VLLM_MODEL=qwen3:4b-instruct-2507

# Agent and extraction/resolution: the M1 Max, through the tunnel
AGENT_BASE_URL=http://localhost:11435/v1
AGENT_MODEL=qwen3:30b-a3b-instruct-2507-q4_K_M
EXTRACTION_BASE_URL=http://localhost:11435/v1
EXTRACTION_MODEL=qwen3:30b-a3b-instruct-2507-q4_K_M
# 64 GB M1 Max: qwen3.6:35b-a3b-q4_K_M for both, plus thinking off for JSON roles:
# AGENT_MODEL=qwen3.6:35b-a3b-q4_K_M
# EXTRACTION_MODEL=qwen3.6:35b-a3b-q4_K_M
# STRUCTURED_REASONING_EFFORT=none

# Router on the small local model; judge from a different model family
ROUTER_MODEL=qwen3:4b-instruct-2507
JUDGE_MODEL=llama3.1:8b

# Embeddings: bge-m3 on the local Ollama (1024 dimensions, multilingual)
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_API_KEY=ollama
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSIONS=1024

# Local models are slower than a GPU server: give them time and fewer parallel calls
LLM_TIMEOUT_S=300
AGENT_TIMEOUT_S=900
EXTRACTION_CONCURRENCY=2

# Neo4j and telemetry from `podman compose up -d neo4j otel-collector jaeger`
NEO4J_URI=bolt://localhost:7687
NEO4J_PASSWORD=
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=no_content
DEPLOYMENT_ENVIRONMENT=local
